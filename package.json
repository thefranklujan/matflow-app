{
  "name": "matflow-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview": "next build && next start",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "ALLOW_TEST_DB_MUTATION=1 vitest run",
    "test:coverage": "ALLOW_TEST_DB_MUTATION=1 vitest run --coverage",
    "test:coverage:critical": "ALLOW_TEST_DB_MUTATION=1 vitest run --coverage --coverage.thresholds.lines=0 --coverage.include=src/lib/entitlements.ts --coverage.include=src/lib/owner-access.ts --coverage.include=src/lib/stripe.ts --coverage.include=src/lib/member-capacity.ts --coverage.include=src/lib/analytics-metrics.ts --coverage.include=src/lib/founder-metrics.ts --coverage.include=src/lib/auth-context.tsx --coverage.include=src/lib/test-db-safety.ts --coverage.include='src/app/api/billing/**' --coverage.include='src/app/api/webhooks/**' --coverage.include='src/app/api/orders/**' --coverage.include='src/app/api/leads/**'",
    "screenshots": "node scripts/capture-app-store-screenshots.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:e2e:functional": "playwright test --project=desktop --project=mobile",
    "test:e2e:visual": "playwright test --project=visual",
    "stripe:readiness": "node scripts/stripe-readiness.mjs",
    "stripe:readiness:test": "node scripts/stripe-readiness.mjs --config .env.stripe-test",
    "stripe:lifecycle": "node scripts/stripe-lifecycle.mjs"
  },
  "dependencies": {
    "@awesome-cordova-plugins/onesignal": "^9.1.4",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "^15.5.22",
    "onesignal-cordova-plugin": "^5.3.6",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-onesignal": "^3.5.1",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@capacitor/cli": "^7.6.8",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "jsdom": "^29.1.1",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "postcss": "^8.5.25"
  }
}
