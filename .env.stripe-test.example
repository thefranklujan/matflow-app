# MatFlow Stripe TEST-MODE configuration template.
# Names and placeholders only — never commit real values.
# Copy to .env.stripe-test (git-ignored) and fill in test-mode values.

# Test-mode secret or restricted key. MUST start with sk_test_ or rk_test_.
# A live key (sk_live_/rk_live_) is refused by the preflight.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Signing secret from `stripe listen` or a test-mode webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# EXISTING test-mode recurring prices. The tooling never creates prices.
STRIPE_BASIC_PRICE_ID=price_REPLACE_ME_BASIC_49
STRIPE_PRO_PRICE_ID=price_REPLACE_ME_PRO_99

# Local or preview URL only. A production URL is refused.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Approved local test database only (see src/lib/test-db-safety.ts).
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5544/matflow_test?schema=public
