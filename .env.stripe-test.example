# MatFlow Stripe SANDBOX configuration template.
# Names and placeholders only — never commit real values.
#
# Copy to .env.stripe-test (git-ignored) and `chmod 600 .env.stripe-test`.
# Every value below belongs to the dedicated "MatFlow Billing QA" sandbox.

# Sandbox secret or restricted key. MUST start with sk_test_ or rk_test_.
# A live key (sk_live_/rk_live_) is refused with exit code 87.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# One-way fingerprint of the approved sandbox account, written by:
#   npm run stripe:sandbox -- --pin
# The account id itself is never stored.
STRIPE_SANDBOX_FINGERPRINT=REPLACE_ME

# Signing secret printed by `stripe listen` on startup. This is NOT the
# Dashboard endpoint secret; the two differ.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Sandbox prices on SEPARATE products (Stripe forbids two prices sharing a
# product and recurring interval, which would block portal plan switching).
# Written automatically by --provision-sandbox-catalog.
STRIPE_BASIC_PRICE_ID=price_REPLACE_ME_BASIC_49
STRIPE_PRO_PRICE_ID=price_REPLACE_ME_PRO_99

# Portal configuration provisioned in the sandbox. Portal configurations do not
# cross modes, so this is sandbox-only and never applies to live.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME

# Local or preview URL only. A production URL is refused.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Approved local test database only (see src/lib/test-db-safety.ts).
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5544/matflow_test?schema=public
